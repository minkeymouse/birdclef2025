data/
DATABASE/

# Ignore Python bytecode files
__pycache__/
*.py[cod]
*.pyo
*.pyc
*.pyd
*.egg-info/
*.egg
*.whl
*.mypy_cache/
*.pytest_cache/
*.coverage
*.cover
*.hypothesis/
*.tox/
*.venv/
*.env
*.env.*
*.DS_Store
*.vscode/
*.idea/
*.ipynb_checkpoints
*.log
*.sqlite3
*.db
*.csv
*.json
*.xml
*.yaml
*.yml
*.pickle
*.pkl
*.h5
*.hdf5
*.pt
*.pth
*.onnx
*.pb
*.ckpt
*.tar
*.zip
*.tar.gz
*.tgz
*.gz
*.rar
*.7z
ir_models/

# Large data caches
*.npz
*.npy
*.parquet
*.arrow
# Model weight directories
model-weights/
# Experiment output directories (broad — covers all subdirs)
experiments/exp*_outputs/
experiments/**/exp*_outputs/
# External downloaded audio (large)
data/external/
# Perch backbone (big binary)
perch_v2/
# Scratch logs
experiments/_scratch_logs/

# Paper repo (separate git repo for iVDFM thesis-related)
iVDFM/
# Example/discussion external content
example_and_discussion/

# Dead 2026 experiment notebooks (redundant phase4 forks; results recorded in lb_registry.yaml).
# The 4 key notebooks (verbatim/phase4/exp189-full/mattia-fork) stay tracked at notebooks/ top-level.
notebooks/_archive_2026/

# Auto-generated artifacts (deploy.py, q_test_runner.py)
notebooks/**/_last_pushed_version.txt
experiments/_audits_post_v26/q_subsets*.json
experiments/_audits_post_v26/*_preds.npz
experiments/_audits_post_v26/*_results.json

# Session-specific audit artifacts
experiments/_audits_post_v26/_2026_*_session/*.npz
experiments/_audits_post_v26/_2026_*_session/*.json

# External model weights (large binaries)
external_weights/

# Exceptions: config files that should be tracked despite broad rules above
!experiments/lb_registry.yaml
!notebooks/*/kernel-metadata.json
